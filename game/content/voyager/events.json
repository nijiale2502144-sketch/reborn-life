[
  {
    "id": "v_meet_haide",
    "kind": "special",
    "title": "断桅的旧船",
    "text": "码头尽头停着一条断了半截桅杆的旧船。船上的老人叼着烟斗，正对着一堆缆绳发愁。\n“小子，”他头也不抬，“会打水手结吗？”\n你看了一眼，说：“会一点。”\n老人这才抬头，眯着眼睛看你。他就是海德老船长。",
    "options": [
      {
        "label": "帮他把缆绳理好",
        "text": "你一圈一圈地理，海德没说话，只是在你理完的时候，从口袋里摸出一枚被磨得发亮的铜币。\n“明天早上，别迟到。”",
        "fx": [
          "flag+:met_haide",
          "rel:haide+3",
          "agi_exp+2",
          "hometown+2"
        ]
      },
      {
        "label": "说自己只会一点，请他教教",
        "check": {
          "attr": "cha",
          "diff": 10
        },
        "ok": {
          "text": "海德哈哈一笑，把烟斗往旁边一搁：“有意思，上来吧。”",
          "fx": [
            "flag+:met_haide",
            "rel:haide+3",
            "cha_exp+2"
          ]
        },
        "fail": {
          "text": "海德摆摆手：“嘴上会的，我见得多了。”但他还是让你留下来打杂。",
          "fx": [
            "flag+:met_haide",
            "rel:haide+1",
            "cha_exp+1"
          ]
        },
        "fx": []
      },
      {
        "label": "不敢上去，说声打扰了转身走",
        "text": "你走出老远，才听见身后传来一声笑：“胆子这么小，出不了海。”\n你回头，海德已经转过身去了。",
        "fx": [
          "flag+:met_haide",
          "rel:haide+1"
        ]
      }
    ],
    "when": {
      "age": 16,
      "season": "spring"
    },
    "priority": 70,
    "portrait": "haide",
    "scene": "harbor"
  },
  {
    "id": "v_first_storm",
    "kind": "special",
    "title": "第一场风暴",
    "text": "海德带你出海的第一个秋天，天边的云在一刻钟里就黑了下来。\n“收帆！”他吼。浪头像一堵墙，扑过来的时候，整条船像一片树叶。\n你的手在发抖，嗓子里有什么东西卡着。",
    "options": [
      {
        "label": "抓牢舵，死也不松手",
        "check": {
          "attr": "wil",
          "diff": 11
        },
        "ok": {
          "text": "你咬紧牙，硬生生把船头顶住了浪。风暴过去的时候，海德靠在桅杆上，喘着气笑：“你小子……行。”",
          "fx": [
            "flag+:storm_survived",
            "wil_exp+5",
            "rel:haide+2",
            "count:voyages+1",
            "exp+20"
          ]
        },
        "fail": {
          "text": "一个浪头把你从舵边掀翻，海德骂着娘接过了舵。你趴在甲板上，吐得天昏地暗。",
          "fx": [
            "hp-10",
            "wil_exp+2",
            "rel:haide+1",
            "count:voyages+1"
          ]
        },
        "fx": []
      },
      {
        "label": "照海德说的收帆",
        "text": "你和他配合着，把帆一面一面地收了下来。船安静了一些。",
        "fx": [
          "agi_exp+3",
          "rel:haide+1",
          "count:voyages+1",
          "flag+:storm_survived"
        ]
      },
      {
        "label": "缩在舱里，等风暴过去",
        "text": "风暴过去之后，海德把你从舱里拎出来：“记住，船上没有观众。”",
        "fx": [
          "rel:haide-1",
          "count:voyages+1"
        ]
      }
    ],
    "when": {
      "age": 16,
      "season": "autumn"
    },
    "priority": 65,
    "portrait": "haide",
    "scene": "sea"
  },
  {
    "id": "v_meet_bram",
    "kind": "special",
    "title": "码头上的布拉姆",
    "text": "一个红头发的年轻人，在码头上和你一起抢活儿。两个人同时伸手去抓一捆货，又同时松开。\n“你先。”他说。\n“你先。”你说。\n两个人都笑了。他叫布拉姆，是个跟你一样，什么都缺，却什么都敢干的家伙。",
    "options": [
      {
        "label": "请他喝一杯麦酒",
        "text": "他一口干了：“交个朋友。以后你有船，我给你当大副。”",
        "fx": [
          "flag+:met_bram",
          "rel:bram+3",
          "cha_exp+2",
          "gold-5"
        ]
      },
      {
        "label": "和他比谁扛得更多",
        "check": {
          "attr": "str",
          "diff": 11
        },
        "ok": {
          "text": "你们比到最后，一个人扛了三袋，另一个人扛了两袋半。他哈哈大笑：“服了，你赢了。”",
          "fx": [
            "flag+:met_bram",
            "rel:bram+2",
            "str_exp+3"
          ]
        },
        "fail": {
          "text": "你扛到第二袋就踉跄了。他拍拍你的肩：“不急，多吃点。”",
          "fx": [
            "flag+:met_bram",
            "rel:bram+2",
            "str_exp+1"
          ]
        },
        "fx": []
      },
      {
        "label": "点点头，各干各的",
        "text": "他看了你一眼，耸耸肩，转身去了另一个码头。",
        "fx": [
          "flag+:met_bram",
          "rel:bram+1"
        ]
      }
    ],
    "when": {
      "age": 17,
      "season": "spring"
    },
    "priority": 65,
    "portrait": "bram",
    "scene": "harbor"
  },
  {
    "id": "v_meet_vel",
    "kind": "special",
    "title": "带着六分仪的陌生人",
    "text": "一个外乡人，带着一只被海水泡得发白的皮箱，在码头上拦住了你。\n“你认识海德老船长吗？”她问，“我是领航员薇尔，听说他手里，有一张没画完的星图。”\n她的眼神认真，认真得像在看一页没写完的字。",
    "options": [
      {
        "label": "带她去找海德",
        "text": "海德看见她，沉默了很久，最后只说：“……坐吧。”这一夜，你在门外守着，听里面说了很久的话。",
        "fx": [
          "flag+:met_vel",
          "rel:haide+1",
          "int_exp+2"
        ]
      },
      {
        "label": "先问她为什么要找那张图",
        "check": {
          "attr": "int",
          "diff": 12
        },
        "ok": {
          "text": "薇尔把一张手绘的星表摊开：“我的老师，也在找同样的东西。”你们彼此看了很久。",
          "fx": [
            "flag+:met_vel",
            "int_exp+3"
          ]
        },
        "fail": {
          "text": "她笑了笑，没有回答，只是把皮箱抱得更紧了。",
          "fx": [
            "flag+:met_vel"
          ]
        },
        "fx": []
      },
      {
        "label": "说不认识，请她另找别人",
        "text": "薇尔点点头，没有勉强。第二天，你在码头上又看见了她，坐在最远的一个缆桩上。",
        "fx": [
          "flag+:met_vel"
        ]
      }
    ],
    "when": {
      "age": 18,
      "season": "autumn"
    },
    "priority": 60,
    "portrait": "vel",
    "scene": "harbor_dusk"
  },
  {
