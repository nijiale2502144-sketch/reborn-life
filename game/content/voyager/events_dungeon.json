[
  {
    "id": "v_de_reef_light",
    "kind": "dungeon",
    "title": "礁石上的灯",
    "text": "雾里，一座礁石上，亮着一盏灯。\n灯下，有一个人影，一动不动。",
    "options": [
      {
        "label": "靠近，看看是谁",
        "check": {
          "attr": "wil",
          "diff": 11
        },
        "ok": {
          "text": "那是一具被海水泡白的尸体，手里还攥着一个小小的铜铃。你合上了他的眼睛，把铜铃带走了。",
          "fx": [
            "gold+25",
            "wil_exp+2"
          ]
        },
        "fail": {
          "text": "你靠得太近，一只躲在礁石后的海蛇扑了出来。",
          "fx": [
            "hp-8"
          ]
        }
      },
      {
        "label": "绕开，不理会",
        "text": "你把船头转了个方向，没有回头。",
        "fx": [
          "agi_exp+2"
        ]
      }
    ],
    "dungeons": [
      "reef"
    ],
    "weight": 8
  },
