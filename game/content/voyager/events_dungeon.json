  {
    "id": "v_de_wreck_ghost",
    "kind": "dungeon",
    "title": "船魂的低语",
    "text": "船舱里，一个穿着旧式制服的幽灵，坐在船长椅上，一动不动。\n你走近的时候，他缓缓地抬起头：“你……也是来找那个门的吗？”",
    "options": [
      {
        "label": "问他：什么门？",
        "text": "幽灵没有回答，只是指了指舱壁上的一行小字：“深渊……会唱歌。”",
        "fx": [
          "count:abyss_clue+1",
          "wil_exp+2"
        ]
      },
      {
        "label": "不回答，快步离开",
        "text": "你没有回头，但身后，那句话一直在回荡。",
        "fx": [
          "wil_exp+1"
        ]
      }
    ],
    "dungeons": [
      "wreck"
    ],
    "weight": 8
  },
