  {
    "id": "v_de_abyss_voice",
    "kind": "dungeon",
    "title": "深渊的声音",
    "text": "深渊的边缘，有什么东西，在轻轻地叫你的名字。\n声音像潮水，一遍一遍，漫过你的脚踝。",
    "options": [
      {
        "label": "捂住耳朵，往前走",
        "check": {
          "attr": "wil",
          "diff": 15
        },
        "ok": {
          "text": "你咬紧牙，一步一步地向前。声音渐渐地，被你抛在了身后。",
          "fx": [
            "wil_exp+5",
            "exp+30"
          ]
        },
        "fail": {
          "text": "你听了太久，眼前一阵发黑。醒来时，你已经站在了原地，浑身冷汗。",
          "fx": [
            "hp-14",
            "wil_exp+2"
          ]
        }
      },
      {
        "label": "停下，回应它",
        "text": "你张开口，说出了自己的名字。深渊，安静了一瞬。",
        "fx": [
          "count:abyss_clue+1",
          "wil_exp+3",
          "hp-6"
        ]
      }
    ],
    "dungeons": [
      "abyss_gate"
    ],
    "weight": 8
