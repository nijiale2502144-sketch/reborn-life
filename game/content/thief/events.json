        ]
      },
      {
        "label": "从后院绕进去，把孩子们先带走",
        "check": {
          "attr": "agi",
          "diff": 13
        },
        "ok": {
          "text": "你们从后院的墙洞里把孩子一个个送了出去。红手帮的人闯进去的时候，只抓到了一屋子的空床。",
          "fx": [
            "flag+:orphan_defended",
            "hometown+6",
            "rel:lila+2",
            "agi_exp+3"
          ]
