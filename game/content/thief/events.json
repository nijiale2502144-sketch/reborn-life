            "hometown-4",
            "flag+:orphan_defended"
          ]
        }
      },
      {
        "label": "不管了，这不是你的事",
        "text": "第二天，孤儿院的门被钉上了板。你路过时，没敢抬头。",
        "fx": [
          "hometown-10",
          "rel:lila-3",
          "flag+:orphan_cold"
        ]
      }
    ],
    "when": {
      "age": 22,
      "season": "autumn"
    },
    "priority": 55,
    "portrait": "lila",
    "scene": "alley"
  },
  {
    "id": "t_rat_dying",
    "kind": "special",
    "title": "灰鼠的最后一夜",
    "text": "冬天最冷的那个夜晚，灰鼠把你叫到了他的阁楼。\n老人躺在一张发黑的床板上，脸色灰得像他的名字。“咳……别哭，”他说，“我这辈子偷过的东西，比你见过的都多，没什么亏的。”\n他从枕下摸出一枚小小的、断了一半的钥匙，塞进你手里。",
    "options": [
      {
        "label": "握住他的手，一直陪到天亮",
        "text": "灰鼠没有再说话。天亮前，他的手慢慢松开了。你把那半把钥匙贴在胸口，坐了很久。",
        "fx": [
          "flag+:rat_dead",
          "flag+:half_key",
          "rel:rat+3",
          "wil_exp+4",
          "hometown+2"
        ],
        "cond": "rel.rat>=4",
        "reason": "灰鼠还没信任你到这个地步（好感 ≥ 4）"
      },
      {
        "label": "接过钥匙，问他另一半在哪",
        "text": "灰鼠笑了，笑得很吃力：“……最没人想看的地方。”这是他留下的最后一句话。",
        "fx": [
          "flag+:rat_dead",
          "rel:rat+1",
          "wil_exp+2"
        ]
      },
      {
        "label": "什么也不说，只是点点头",
        "text": "你站在床边，看着他一点点变凉。窗外的雪下得很静。",
        "fx": [
          "flag+:rat_dead",
          "wil_exp+3"
        ]
      }
    ],
    "when": {
      "age": 22,
      "season": "winter"
    },
    "priority": 75,
    "portrait": "rat",
    "scene": "alley_snow"
  },
  {
    "id": "t_mask_invite",
    "kind": "special",
    "title": "面具先生的邀请",
    "text": "一张没有署名的邀请函，夹在你每天经过的那块松动的砖缝里。\n公会大厅的最深处，一个戴着白色无面面具的人，背对着你站着。“影子，”他说，声音像是从很远的井底传上来，“月蚀之夜，我需要一双最快的手。”\n他知道你的所有事，也知道你不知道的那一部分。",
    "options": [
      {
        "label": "答应他，听听他的条件",
        "text": "“你只需要在魔晶库里，替我拿一样东西。别的，随你。”他递给你一枚金币，“预付。”",
        "fx": [
          "flag+:mask_hired",
          "rep:shadow+8",
          "gold+150",
          "count:intel+1"
        ]
      },
      {
        "label": "婉拒，说你有自己的计划",
        "check": {
          "attr": "cha",
          "diff": 14
        },
        "ok": {
          "text": "面具沉默了一会儿：“很好。有自己想法的人，才值得信任。”他没有再逼你。",
          "fx": [
            "rep:shadow+5",
            "cha_exp+3"
          ]
        },
        "fail": {
          "text": "面具轻轻地“嗯”了一声。你的背后，不知什么时候多出了几个人。“……再考虑考虑。”",
          "fx": [
            "count:heat+8",
            "rep:shadow-3"
          ]
        }
      },
      {
        "label": "装作恭敬，暗中留意他的破绽",
        "check": {
          "attr": "int",
          "diff": 13
        },
        "ok": {
          "text": "他说话时，左手总是下意识地摸一下腰间。那里，似乎挂着什么东西。",
          "fx": [
            "count:mask_clue+1",
            "int_exp+3",
            "count:intel+1"
          ]
        },
        "fail": {
          "text": "你什么也没看出来，只觉得后背发凉。",
          "fx": [
            "int_exp+1"
          ]
        }
      }
    ],
    "when": {
      "age": 23,
      "season": "spring"
    },
    "priority": 60,
    "portrait": "mask",
    "scene": "tavern"
  },
  {
    "id": "t_last_job",
    "kind": "special",
    "title": "最后一票",
    "text": "年轻的时候，你从没想过自己会有退路。\n可今天，你的钱袋里有了一点分量，街角那家要转让的小铺子，又被人提起了。\n“金盆洗手吧，”莉拉说，“你已经做得够多了。”",
    "options": [
      {
        "label": "金盆洗手，开一间修锁的铺子",
        "text": "你把撬锁工具擦干净，放进了柜台下的抽屉。从今天起，你只修锁，不开锁。",
        "fx": [
          "flag+:retired",
          "end:auto"
        ],
        "cond": "gold>=800&&hometown>=30",
        "reason": "需要金币 ≥ 800，街区人望 ≥ 30",
        "avoid": true
      },
      {
        "label": "再干一票，攒够再说",
        "text": "你把铺子的事暂时压在了心底。",
        "fx": [
          "wil_exp+1"
        ]
      },
      {
        "label": "不，我要去月蚀之夜",
        "text": "莉拉叹了口气，没有再劝。",
        "fx": [
          "wil_exp+2",
          "cha_exp+1"
        ]
      }
    ],
    "when": {
      "age": 25,
      "season": "spring"
    },
    "priority": 50,
    "portrait": "lila",
    "scene": "alley"
