[
  {
    "id": "t_meet_rat",
    "kind": "special",
    "title": "灰鼠",
    "text": "夜里，你的手刚伸进一个老头的袖子，就被另一只更快的手扣住了。\n“手法不错，”老头吐掉嘴里的草茎，“就是脸上写着‘我在偷’三个字。”\n他松开手，看着你，像在掂量一块不知道值不值钱的料。",
    "options": [
      {
        "label": "老老实实挨训，问他是谁",
        "text": "“鼠街的灰鼠，”他说，“想活得久一点，就跟我来。”从这一夜起，你有了一个师父，虽然他从来不承认。",
        "fx": [
          "flag+:met_rat",
          "rel:rat+3",
          "int_exp+2"
        ]
      },
      {
        "label": "趁他不备，再偷一次",
        "check": {
          "attr": "agi",
          "diff": 14
        },
        "ok": {
          "text": "你在他松手的刹那，摸走了他的烟袋。灰鼠愣了一下，哈哈大笑：“有意思，真有意思！”",
          "fx": [
            "flag+:met_rat",
            "rel:rat+3",
            "agi_exp+4",
            "gold+10"
          ]
        },
        "fail": {
          "text": "他连头也没回，一把按住你的手，顺势拧了半圈。“疼吗？记住这个疼。”",
          "fx": [
            "hp-6",
            "flag+:met_rat",
            "rel:rat+1",
            "agi_exp+1"
          ]
        }
      },
      {
        "label": "掉头就跑",
        "text": "你钻进巷子，跑了三条街才敢回头。身后没有脚步声，只有一声很轻的笑。",
        "fx": [
          "agi_exp+2",
          "flag+:met_rat"
        ]
      }
    ],
    "when": {
      "age": 16,
      "season": "autumn"
    },
    "priority": 70,
    "portrait": "rat",
    "scene": "alley"
  },
  {
    "id": "t_meet_lila",
    "kind": "special",
    "title": "巷口的女孩",
    "text": "你在蹲点的时候，被人从背后拍了一下。回头，是个扎着脏辫子的女孩，指着你要偷的那辆货车：“别动，那是孤儿院的粮。”\n她叫莉拉，十五岁，在孤儿院长大，偶尔也替嬷嬷“拿”点东西。",
    "options": [
      {
        "label": "把到手的面包分她一半",
        "text": "她接过去，咬了一口：“……行，你不算坏人。”",
        "fx": [
          "flag+:met_lila",
          "rel:lila+3",
          "hometown+2"
        ]
      },
      {
        "label": "跟她打听孤儿院的事",
        "text": "莉拉说了很多：谁家的孩子被送走，谁的病没人管。你听着，心里有点堵。",
        "fx": [
          "flag+:met_lila",
          "rel:lila+2",
          "cha_exp+2"
        ]
      },
      {
        "label": "不理她，转身走掉",
        "text": "你走出老远，才发现她一直在后面远远地看着你。",
        "fx": [
          "flag+:met_lila",
          "rel:lila+1"
        ]
      }
    ],
    "when": {
      "age": 17,
      "season": "spring"
    },
    "priority": 65,
    "portrait": "lila",
    "scene": "alley"
  },
  {
    "id": "t_red_threat",
    "kind": "special",
    "title": "红手印",
    "text": "一夜之间，鼠街的墙上多了一只红手印。\n红手帮的人在街口收“保护费”：卖菜的、修鞋的、摆摊的，一个也不放过。领头的是个缺了小指的男人，人称「断指」。\n有人悄悄看向你，什么也没说。",
    "options": [
      {
        "label": "先观察几天，看他们的人手",
        "text": "你蹲在屋顶上数了三个晚上。他们有十二个人，三条狗，一间仓库。",
        "fx": [
          "flag+:red_hand_threat",
          "int_exp+3",
          "count:intel+1",
          "quest:start:red_hand_war"
        ]
      },
      {
        "label": "去找灰鼠商量",
        "text": "灰鼠听完，沉默了很久：“红手帮不是普通的地头蛇。小心点，别一个人去。”",
        "fx": [
          "flag+:red_hand_threat",
          "rel:rat+1",
          "quest:start:red_hand_war"
        ]
      },
      {
        "label": "装作没看见",
        "text": "但街坊们看你的眼神，变得有点不一样。",
        "fx": [
          "flag+:red_hand_threat",
          "hometown-3",
          "quest:start:red_hand_war"
        ]
      }
    ],
    "when": {
      "age": 19,
      "season": "summer"
    },
    "priority": 60,
    "portrait": "cass",
    "scene": "alley"
  },
  {
    "id": "t_meet_cass",
    "kind": "special",
    "title": "追捕",
    "text": "那晚你从一户人家后窗出来，迎面就是一队巡逻的火把。\n为首的是个年轻的女捕快，目光像刀。“站住。”她说，声音不高，却让你的腿停了半拍。\n她叫卡斯，是新上任的巡逻队队长。",
    "options": [
      {
        "label": "翻上屋顶，拔腿就跑",
        "check": {
          "attr": "agi",
          "diff": 14,
          "fateDiff": 1,
          "memDiff": {
            "id": "m_t_cass",
            "diff": -2
          }
        },
        "ok": {
          "text": "你从屋檐一路跑过三条街，把火把的光远远甩在身后。卡斯站在巷口，看着屋顶上你的背影，一动不动。",
          "fx": [
            "flag+:met_cass",
            "agi_exp+4",
            "count:heat+6"
          ]
        },
        "fail": {
          "text": "你从屋顶上滑了下去，摔在一堆麻袋上。卡斯的火把照着你，“带走。”",
          "fx": [
            "flag+:met_cass",
            "hp-8",
            "count:heat+10",
            "gold-20",
            "log:卡斯把你拎回巡逻队，盘问了一整夜。没有证据，只能放人。她在你离开前，说了一句：“我会盯着你。”"
          ]
        }
      },
      {
        "label": "丢下一枚金币，装作路人",
        "text": "卡斯没接。“路人不会半夜从后窗出来。”她看了你很久，才让开了路。“……我记住你了。”",
        "fx": [
          "flag+:met_cass",
          "gold-15",
          "count:heat+4",
          "cha_exp+2"
        ],
        "cond": "gold>=15",
        "reason": "金币不足"
      },
      {
        "label": "点头哈腰，说自己是送货的",
        "check": {
          "attr": "cha",
          "diff": 13
        },
        "ok": {
          "text": "你一连串的谎话说得天衣无缝。卡斯皱着眉，最后还是放了你。",
          "fx": [
            "flag+:met_cass",
            "cha_exp+4"
          ]
        },
        "fail": {
          "text": "她盯着你的鞋看了一眼，那上面还沾着别人家窗台上的青苔。",
          "fx": [
            "flag+:met_cass",
            "count:heat+8",
            "gold-15",
            "log:卡斯没有证据，只能放你走。她盯着你的背影，一直盯到你转过街角。"
          ]
        }
      }
    ],
    "when": {
      "age": 20,
      "season": "winter"
    },
    "priority": 60,
    "portrait": "cass",
    "scene": "alley_snow"
  },
  {
    "id": "t_orphan_raid",
    "kind": "special",
    "title": "深夜的孤儿院",
    "text": "半夜，莉拉气喘吁吁地敲你的窗：“红手帮的人在孤儿院门口，他们要抢地契！”\n你赶到的时候，七八个人正堵在门口，孩子们挤在二楼窗后，哭声一阵一阵传出来。",
    "options": [
      {
        "label": "冲进去，挡在门口",
        "text": "你一脚踹开最前面的人，把嬷嬷护在身后。",
        "fx": [
          {
            "type": "combat",
            "enemy": "red_hand",
            "win": [
              "flag+:orphan_defended",
              "hometown+8",
              "rel:lila+2",
              "exp+30",
              "log:红手帮的人被你们打跑了。"
