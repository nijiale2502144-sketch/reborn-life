          "attr": "wil",
          "diff": 11
        },
        "ok": {
          "text": "火光里，鼠群骚动着退了回去。你从它们让出的缝隙里，发现了一个被啃坏的小箱子。",
          "fx": [
            "gold+25",
            "wil_exp+2"
          ]
        },
        "fail": {
          "text": "火把被撞灭了，你被咬了好几口。",
          "fx": [
            "hp-10",
            "wil_exp+1"
          ]
        }
      },
      {
        "label": "躲进一条侧道",
        "text": "你躲在一个狭窄的管道里，听着鼠群从身边涌过。",
        "fx": [
          "agi_exp+2"
        ]
      }
    ],
    "dungeons": [
      "sewer"
    ],
    "weight": 8
