[
  {
    "id": "n_market",
    "kind": "chain",
    "title": "王都集市",
    "text": "集市里，魔法商人的摊位和旧书摊挤在同一条窄街上。卖药水的小贩嗓门最大，卖魔晶的老头最沉默。你摸了摸钱袋，里面的重量让你有点心虚。",
    "options": [
      {
        "label": "买一根橡木法杖（120 金币）",
        "text": "法杖握在手里有点凉，杖头的蓝晶在日光下闪了一下。",
        "fx": [
          "gold-120",
          "item:oak_staff",
          "flag+:has_staff"
        ],
        "cond": "gold>=120&&!flag:has_staff",
        "reason": "金币不足或已拥有"
      },
      {
        "label": "买一件学徒法袍（100 金币）",
        "text": "深蓝色的袍子，袖口绣着星纹。穿上后，镜子里的人忽然像个像样的学徒。",
        "fx": [
          "gold-100",
          "item:mage_robe",
          "flag+:has_robe"
        ],
        "cond": "gold>=100&&!flag:has_robe",
        "reason": "金币不足或已拥有"
      },
      {
        "label": "买一瓶魔力药剂（40 金币）",
        "text": "带着薄荷凉味的蓝色药剂，一口下去，胸口的空虚被慢慢填满。",
        "fx": [
          "gold-40",
          "mpheal:0.8"
        ],
        "cond": "gold>=40",
        "reason": "金币不足"
      },
      {
        "label": "买一瓶伤药（30 金币）",
        "text": "苦得你直皱眉，伤口却很快不疼了。",
        "fx": [
          "gold-30",
          "heal:0.6"
        ],
        "cond": "gold>=30",
        "reason": "金币不足"
      },
      {
        "label": "买一本旧魔导书（50 金币）",
        "text": "书脊上的烫金早已磨光，但里面有前人密密麻麻的批注。",
        "fx": [
          "gold-50",
          "int_exp+8",
          "count:arcana+1"
        ],
        "cond": "gold>=50",
        "reason": "金币不足"
      },
      {
        "label": "请高塔的高年级学徒指点（60 金币）",
        "text": "对方一边收钱一边挑你的毛病，挑完又纠正了三个你一直没发觉的错。",
        "fx": [
          "gold-60",
          "int_exp+5",
          "wil_exp+3",
          "exp+10"
        ],
        "cond": "gold>=60",
        "reason": "金币不足"
      },
      {
        "label": "向教会的施粥处捐一些钱（20 金币）",
        "text": "没人知道你是谁。但粥铺的老太太把你的名字，写进了捐赠簿里。",
        "fx": [
          "gold-20",
          "rep:church+3",
          "hometown+1"
        ],
        "cond": "gold>=20",
        "reason": "金币不足"
      },
      {
        "label": "走进内间看看贵重货（只对有魅力的人开放）",
        "fx": [
          "goto:n_market_vip"
        ],
        "text": "店员看了看你的袖口，掀开了内间的帘子。"
      },
      {
        "label": "什么也不买，转一圈",
        "text": "你看了很久，最后只是买了一块糖，带回去给母亲。",
        "fx": [
          "cha_exp+1",
          "rel:vera+1"
        ]
      }
    ],
    "scene": "street"
  },
  {
    "id": "n_teahouse",
    "kind": "chain",
    "title": "茶馆",
    "text": "茶馆里烟气氤氲，每一桌都在小声议论别人的事。你找了个靠窗的位置坐下，伙计很快端来了一壶茶。",
    "options": [
      {
        "label": "喝一壶热茶，吃点点心（6 金币）",
        "text": "热茶下肚，一整天的疲惫都散了。",
        "fx": [
          "gold-6",
          "heal:0.4",
          "mpheal:0.4",
          "status-:fatigue"
        ],
        "cond": "gold>=6",
        "reason": "金币不足"
      },
      {
        "label": "请邻座喝一杯，打听消息（8 金币）",
        "text": "邻座的人话匣子一打开，就收不住了。",
        "fx": [
          "gold-8",
          "cha_exp+2",
          {
            "if": "count.rumor==0",
            "then": [
              "log:听说当年的会审书记官里，有一位后来回了乡下，据说一直留着一份抄本。",
              "count:evidence+1"
            ],
            "else": [
              {
                "if": "count.rumor==1",
                "then": [
                  "log:听说高塔的下一轮考核，会特别看重“实操”，不是死背书。",
                  "rep:tower+2"
                ],
                "else": [
                  {
                    "if": "count.rumor==2",
                    "then": [
                      "log:听说洛克伍德家的少爷，最近和他父亲吵了一架。",
                      "count:valen_clash+1"
                    ],
                    "else": [
                      {
                        "if": "count.rumor==3",
                        "then": [
                          "log:听说债主们最近换了新的管事，对旧账“会宽限一些”。",
                          "count:debt-40"
                        ],
                        "else": [
                          "exp+8"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "count:rumor+1"
        ],
        "cond": "gold>=8",
        "reason": "金币不足"
      },
      {
        "label": "和人下一盘棋，押 20 金币",
        "check": {
          "attr": "int",
          "diff": 11
        },
        "ok": {
          "text": "你布了一个很长的局，对手落子越来越慢，最后推倒了自己的王。",
          "fx": [
            "gold+34",
            "int_exp+3"
          ]
        },
        "fail": {
          "text": "你输了半子，对手笑着把钱收了过去。",
          "fx": [
            "gold-20",
            "int_exp+2"
          ]
        },
        "cond": "gold>=20",
        "reason": "金币不足"
      },
      {
        "label": "坐一会儿就走",
        "text": "你听了半个时辰的闲话，没有一句是新的。",
        "fx": [
          "wil_exp+1"
        ]
      }
    ],
    "scene": "street"
  },
  {
    "id": "n_vera_recover",
    "kind": "chain",
    "title": "母亲的病情",
    "text": "药煎了一服又一服。深冬的某个夜里，母亲忽然睁开眼，轻声叫了你的名字，声音很虚，却是清醒的。",
    "options": [
      {
        "label": "守在床边，一夜没合眼",
        "text": "你握着她的手，一直到天亮。她的手心渐渐有了温度。",
        "fx": [
          "flag+:vera_better",
          "rel:vera+3",
          "wil_exp+3"
        ]
      },
      {
        "label": "请城里最好的医生再来看一次（60 金币）",
